#!/usr/bin/env node

const { spawnSync } = require("node:child_process");
const { join } = require("node:path");

const result = spawnSync(join(__dirname, "wuu-bin"), process.argv.slice(2), {
  stdio: "inherit",
});

if (result.error) {
  console.error(`Failed to start wuu: ${result.error.message}`);
  process.exit(1);
}

process.exit(result.status ?? 1);
