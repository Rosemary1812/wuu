{
  "name": "@blueberrycongee/wuu-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:e2e:permission-mode": "npm run build && electron scripts/permission-mode-e2e.cjs",
    "test:e2e:streaming": "VITE_ENABLE_RUN_DEBUG_PANEL=true npm run build && electron scripts/streaming-e2e.cjs",
    "test:e2e:process-handoff": "npm run build && electron scripts/process-handoff-e2e.cjs",
    "test:e2e:window-resize": "npm run build && electron scripts/window-resize-perf-e2e.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
