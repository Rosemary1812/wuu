{
  "name": "@blueberrycongee/wuu-desktop",
  "version": "0.3.1",
  "description": "Desktop app for the Wuu AI coding agent",
  "author": "Andy wu <lpageo@163.com>",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:collaboration": "VITE_ENABLE_COLLABORATION=true npm run dev",
    "dev:remote": "VITE_ENABLE_REMOTE_CONTROL=true npm run dev",
    "dev:direct": "WUU_ENABLE_CUA_MAC=1 node scripts/build-cua-mac.cjs && WUU_ENABLE_CUA_MAC=1 electron-vite dev",
    "build:cua-mac": "node scripts/build-cua-mac.cjs",
    "build:core": "node scripts/build-core.cjs",
    "build": "electron-vite build",
    "pack:mac": "npm run build:core && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --publish=never",
    "dist:mac": "npm run build:core && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish=never",
    "release:desktop": "npm run dist:mac",
    "test": "npm run typecheck && npm run test:dev-launcher && npm run test:unit && npm run test:perf && npm run test:cua-mac",
    "test:dev-launcher": "node scripts/test-dev-launcher.cjs",
    "test:unit": "VITE_ENABLE_COLLABORATION=true vitest run --exclude=src/renderer/StreamingMarkdown.perf.test.tsx",
    "test:perf": "vitest run src/renderer/StreamingMarkdown.perf.test.tsx --maxWorkers=1 --minWorkers=1",
    "test:cua-mac": "node scripts/test-cua-mac.cjs",
    "test:watch": "vitest --exclude=src/renderer/StreamingMarkdown.perf.test.tsx",
    "test:e2e:permission-mode": "npm run build && electron scripts/permission-mode-e2e.cjs",
    "test:e2e:streaming": "VITE_ENABLE_RUN_DEBUG_PANEL=true npm run build && electron scripts/streaming-e2e.cjs",
    "test:e2e:process-handoff": "npm run build && electron scripts/process-handoff-e2e.cjs",
    "test:e2e:window-resize": "npm run build && electron scripts/window-resize-perf-e2e.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pierre/trees": "^1.0.0-beta.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.53.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "build": {
    "appId": "com.blueberrycongee.wuu",
    "productName": "wuu",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!wuu-cua-mac*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
