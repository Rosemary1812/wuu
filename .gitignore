# ============================================================
# Build artifacts
# ============================================================
# Go build (Makefile → /bin/wuu), goreleaser (→ dist/),
# electron-vite (→ desktop/out/, .vite/, node_modules/),
# pnpm/npm (→ node_modules/).

/bin/
dist/
node_modules/
.vite/
desktop/out/
# Desktop release packaging writes the generated Go core and installer
# artifacts under tracked icon resources.
desktop/build/bin/
desktop/release/
# electron-vite writes a timestamp marker when it re-syncs node_modules;
# keep it out of git.
desktop/.node_modules.synced

# ============================================================
# Local runtime state (per-machine)
# ============================================================
# Git cannot re-include a file beneath an excluded directory,
# so we exclude .wuu/ broadly and re-include the files we
# DO want tracked.

.wuu.json
.wuu/*
!.wuu/settings.json
.wuu/settings.local.json

# ============================================================
# Vendored / reference material
# ============================================================

thirdparty/

# ============================================================
# Local docs / notes
# ============================================================
# /docs is mostly personal scratch; an explicit allow-list keeps
# the small set of shared project docs tracked.

/docs/*
!/docs/exec.md
!/docs/app-server-protocol.md
!/docs/jsonl-events.md
!/docs/compat/
!/docs/plans/
/docs/plans/*
!/docs/plans/2026-07-09-goal-workflow-ledger-cleanup.md

/GOAL_*.md                      # per-thread goal scratch
/prototypes/                    # throwaway prototype dirs

# ============================================================
# Local agent / shell / editor config
# ============================================================

# AI agent scratchpads (each shell/contributor brings its own)
CLAUDE.md
.claude/
.mavis/
.opencode/

# Editors
.vscode/
.idea/

# Worktrees (top-level only)
.worktrees/

# OS noise
.DS_Store

# MCP plugin caches
.playwright-mcp/

# ============================================================
# Test / coverage artifacts
# ============================================================

coverage/
coverage.out
*.coverprofile

# ============================================================
# Logs
# ============================================================

*.log

# ============================================================
# Environment files
# ============================================================
# Per-machine secrets. Commit .env.example if a sample is needed.

.env
.env.local
.env.*.local

# ============================================================
# Personal scratch
# ============================================================

# Personal paste-inbox for images.
.paste/

# local redesign reference (matvoyce analysis assets — do NOT commit/ship)
landing/.redesign-ref/

# local CLI build artifact (use ~/go/bin/wuu via `make install`)
/wuu
